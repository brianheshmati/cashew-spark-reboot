import { serve } from "https://deno.land/std@0.177.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", {
      headers: corsHeaders,
    });
  }

  try {
    console.log("=== create-card-authentication ===");

    const body = await req.json();

    const {
        token_id,
        masked_card_number,
        exp_month,
        exp_year,
        brand,
        bank,
        country,
        card_type,
        fingerprint,
      } = body;

    if (!token_id) {
      throw new Error("Missing token_id");
    }
    console.log("body",body);
    
    const supabase = createClient(
      Deno.env.get("SUPABASE_URL")!,
      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
      {
        global: {
          headers: {
            Authorization:
              req.headers.get("Authorization") || "",
          },
        },
      }
    );
    // Check if card already exists
    const { data: existingCard } =
      await supabase
        .from("payment_methods")
        .select("id")
        .eq("fingerprint", fingerprint)
        .maybeSingle();

    if (existingCard) {
      return new Response(
        JSON.stringify({
          success: true,
          message:
            "Card already exists",
        }),
        {
          headers: {
            ...corsHeaders,
            "Content-Type":
              "application/json",
          },
        }
      );
    }
    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) {
      return new Response(
        JSON.stringify({
          error: "Unauthorized",
        }),
        {
          status: 401,
          headers: {
            ...corsHeaders,
            "Content-Type":
              "application/json",
          },
        }
      );
    }

    console.log(
      "Saving verified token:",
      token_id
    );

    // Check if user already has active cards
    const { count, error: countError } =
      await supabase
        .from("payment_methods")
        .select("*", {
          count: "exact",
          head: true,
        })
        .eq("internal_user_id", user.id)
        .eq("is_active", true);

    if (countError) {
      throw countError;
    }

    const isDefault = (count ?? 0) === 0;

    const insertPayload = {
      internal_user_id: user.id,
      provider: "xendit",
      provider_token_id: token_id,
      brand:
        brand && brand !== "UNKNOWN"
          ? brand
          : "Card",
      bank:
        bank && bank !== "UNKNOWN"
          ? bank
          : null,

      country:
        country && country !== "UNKNOWN"
          ? country
          : null,

      card_type:
        card_type && card_type !== "UNKNOWN"
          ? card_type
          : null,
      fingerprint,
      last4:
        masked_card_number
          ? masked_card_number.slice(-4)
          : null,
      exp_month:
        exp_month
          ? parseInt(exp_month)
          : null,
      exp_year:
        exp_year
          ? parseInt(exp_year)
          : null,
      verification_status: "VERIFIED",
      is_active: true,
      is_default: isDefault,
    };

    console.log(
      "Insert payload:",
      insertPayload
    );

    const { error: insertError } =
      await supabase
        .from("payment_methods")
        .insert(insertPayload);

    if (insertError) {
      throw new Error(
        `Failed to save payment method: ${insertError.message}`
      );
    }

    return new Response(
      JSON.stringify({
        success: true,
        token_id,
      }),
      {
        headers: {
          ...corsHeaders,
          "Content-Type":
            "application/json",
        },
      }
    );
  } catch (err: any) {
    console.error(err);

    return new Response(
      JSON.stringify({
        error:
          err.message ||
          "Unknown error",
      }),
      {
        status: 500,
        headers: {
          ...corsHeaders,
          "Content-Type":
            "application/json",
        },
      }
    );
  }
});