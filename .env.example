# Frontend (Vite -- these are shipped to the browser, public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# Edge function secrets. Set with `supabase secrets set`, NEVER in this file
# and never with a VITE_ prefix -- VITE_ vars are bundled into the client.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ESIGNATURES_WEBHOOK_SECRET=<random 32+ chars, also set in esignatures.com>
# CRON_SECRET=<random 32+ chars, sent as x-cron-secret by pg_cron>
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=Cashew Solutions <noreply@yourdomain.ph>
# SUPPORT_EMAIL=support@yourdomain.ph
